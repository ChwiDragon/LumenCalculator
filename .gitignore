# Local tooling
.claude/
.idea/

# Unrelated Windows binary that ended up in this folder
*.winmd

# Assets (character art, fonts, etc.) stay local and never go to GitHub.
# Only the README that explains the file naming is tracked.
assets/**
!assets/characters/
!assets/characters/README.txt
# .nomedia = keep the phone gallery from listing these images when the folder is copied to a phone
!assets/.nomedia
!assets/characters/.nomedia

# Google Play release folder (AAB, store graphics, checklist) - local only
release/
# Placeholder images showing every asset file name the app looks for - local only
asset-dummies/

# Character-art app icon resources generated by app/make-icons.py (release builds only)
app/android/app/src/art/
# Loose images dropped in the project root (e.g. icon sources) stay local
/*.webp
/*.png
/*.jpg

# APK project: installed packages and generated web copy (build-apk.ps1 recreates www/)
app/node_modules/
app/www/
# Signing secrets are ignored in app/android/.gitignore (keystore.properties, *.keystore)

# 개인 문서(권리 합의서 등)는 올리지 않음
/*.pdf

# 공개 웹사이트(LumenCounter 저장소) 작업 폴더 — 그림·글꼴 포함, app/build-site.py가 만듦. 이 저장소에는 올리지 않음
site/
site-tmp/
